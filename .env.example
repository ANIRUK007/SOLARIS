# Copy to .env and fill in. .env is gitignored — never commit real keys.
#
# The previous version of this app shipped both keys inside index.html, which
# put them in the public repository and in its history. Any key that was ever
# committed there must be treated as compromised and rotated at the provider.

PORT=3001

# Where recordings are written. Relative paths resolve next to server.js.
SOLARIS_DATASET_DIR=./dataset

# Speech-to-text. Leave a key blank to disable that engine; the app then
# falls back to manual transcription instead of failing.
SARVAM_API_KEY=
SARVAM_MODEL=saarika:v2.5

GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3-turbo

# HTTPS, required before phones will grant microphone access over the LAN.
# Run `npm run certs` to generate these.
# SSL_CERT=./certs/cert.pem
# SSL_KEY=./certs/key.pem
